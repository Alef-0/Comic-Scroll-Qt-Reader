[Desktop Entry]
Version=1.0
Type=Application
Name=Comic Scroll Reader
GenericName=Comic & Manga Reader
Comment=Continuous scroll and single-page reader for comics, image folders, and PDFs
Exec=comic-scroll-reader %F
Icon=comic-scroll-reader
Terminal=false
Categories=Graphics;Viewer;
MimeType=application/pdf;image/png;image/jpeg;image/webp;image/gif;image/bmp;image/avif;image/tiff;inode/directory;
Keywords=comic;manga;webtoon;reader;pdf;viewer;scroll;images;
StartupWMClass=comic-scroll-reader
StartupNotify=true
